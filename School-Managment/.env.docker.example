# EduCenter - production settings for Docker
#   1. cp .env.docker.example .env
#   2. Fill in SITE_HOST, APP_URL, APP_KEY and MAIL_PASSWORD
#   3. docker compose up -d --build
# The database path is set in compose.yaml, not here.

# IP or domain name of the server (the HTTPS certificate is made for it)
SITE_HOST=192.168.1.100

APP_NAME=EduCenter
APP_ENV=production
# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_DEBUG=false
# Address users open in the browser; activation emails link here
APP_URL=https://192.168.1.100

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

# Daily files in the "storage" volume (kept 14 days) + docker compose logs
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# The site is only served over HTTPS
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# No queue worker runs in Docker: anything queued runs straight away
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Gmail: MAIL_PASSWORD is an app password (https://myaccount.google.com/apppasswords)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=zibereibar@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=zibereibar@gmail.com
MAIL_FROM_NAME=EduCenter
